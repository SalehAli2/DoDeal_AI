# Copy this file to .env and fill in real local values. Never commit .env.
# Must be saved as UTF-8 with no byte order mark — a BOM breaks env parsing silently.

# Gate 1: JWT verification. HS256 today; RS256 requested but not provisioned.
DODEAL_JWT_ALGORITHM=HS256
# Clock-skew tolerance for exp/nbf/iat, in seconds. Never 0: a few seconds of
# drift between the CRM's clock and ours would read as forgery.
DODEAL_JWT_LEEWAY_SECONDS=30
# Required, no default: the service refuses to start without it. Any local value works.
DODEAL_JWT_SIGNING_KEY=change-me-local-only

# Claim-name mapping for the inbound token (sub / subdomain / database).
DODEAL_CLAIM_SUBJECT=sub
DODEAL_CLAIM_SUBDOMAIN=subdomain
DODEAL_CLAIM_DATABASE=database

# Backend tool client: JSON map of tenant subdomain to that tenant's DD-API-KEY.
# No default for any tenant; an unknown tenant fails closed before any call.
DODEAL_DD_API_KEYS={"localtenant":"change-me-local-only"}
DODEAL_BACKEND_BASE_DOMAIN=dodealcrm.com
# The base domain requests to THIS service arrive under: Gate 2 requires
# Host == <tenant>.<this>. Same as the backend domain today, kept separate
# because the host of arrival is still an open question with the backend.
DODEAL_INBOUND_BASE_DOMAIN=dodealcrm.com

# Where prompt templates are read from. Leave unset to use the copies shipped
# inside the package; set only to iterate on prompts locally without a rebuild.
# DODEAL_PROMPTS_DIR=

# Watchdog: timeout and retry policy for every external call.
DODEAL_EXTERNAL_CALL_TIMEOUT_SECONDS=10.0
DODEAL_EXTERNAL_CALL_RETRY_ONCE=true

# LLM seam: unset until a provider and a pinned model are both set.
# DODEAL_LLM_PROVIDER=anthropic
# DODEAL_LLM_MODEL=
DODEAL_LLM_TIMEOUT_SECONDS=60.0
DODEAL_LLM_MAX_OUTPUT_TOKENS=1024
# Per-task model choices as JSON, keyed by profile name (core/llm/profiles.py).
# Empty by default: an unlisted name falls back to the PROVIDER/MODEL pair above
# at temperature 0. A malformed map or unknown provider refuses to start.
# DODEAL_LLM_PROFILES={"unit_a.classify":{"provider":"groq","model":"<id>","temperature":0}}
# The call workers (Unit B) read the same map; their two names, beside Unit A's:
# DODEAL_LLM_PROFILES={"unit_b.extract":{"provider":"groq","model":"<id>","temperature":0},"unit_b.prose":{"provider":"groq","model":"<id>","temperature":0}}
# The stage-2 worker's five names (wave 2), one per pass, on the same map:
# DODEAL_LLM_PROFILES={"unit_b.objections":{"provider":"groq","model":"<id>","temperature":0},"unit_b.score":{"provider":"groq","model":"<id>","temperature":0},"unit_b.escalations":{"provider":"groq","model":"<id>","temperature":0},"unit_b.coaching":{"provider":"groq","model":"<id>","temperature":0},"unit_b.extras":{"provider":"groq","model":"<id>","temperature":0}}
# Three optional fields per profile, each sent only when set: reasoning_effort
# (low|medium|high; temperature is then not sent), response_format
# (json_object, the default, or json_schema with the pass's schema) and seed:
# DODEAL_LLM_PROFILES={"unit_b.extract":{"provider":"openai","model":"<id>","reasoning_effort":"low","response_format":"json_schema","seed":7}}
# The provider API key. SecretStr: a stray repr of Settings prints **********.
# No default and no placeholder -- absent is a ConfigError naming the provider.
# Read in exactly ONE place, the adapter's bearer-header builder.
DODEAL_LLM_API_KEY=change-me-local-only
# Proxy override for the provider base URL. Unset uses the vendor constant in
# core/llm/openai_compatible.py. Set it ONLY to put a proxy in front.
# A wrong value sends every prompt to the wrong host, so it is never logged.
# DODEAL_LLM_BASE_URL=

# Redis: separate logical DBs for the work queue and the cost/quota counters.
# Each URL is a secret (register item 158): a real one carries the password,
# so repr(settings) prints stars and core/redis.py alone reads it.
DODEAL_REDIS_QUEUE_URL=redis://localhost:6379/0
DODEAL_REDIS_COST_URL=redis://localhost:6379/1
DODEAL_REDIS_OPERATIONAL_URL=redis://localhost:6379/2
# Unit B's call jobs and results (register item 50): its own logical DB,
# because jobs fail closed and live for days. Sharing db2 would let a flush
# of reservations erase every call job.
DODEAL_REDIS_JOBS_URL=redis://localhost:6379/3
# Redis connection budget. All four must be positive; the service refuses to
# start otherwise. Connect is far shorter than read on purpose: a slow connect
# means the host is gone, not busy.
DODEAL_REDIS_CONNECT_TIMEOUT_SECONDS=0.25
DODEAL_REDIS_SOCKET_TIMEOUT_SECONDS=1.0
# Optional override of the Redis pool size. Unset = DODEAL_MAX_INFLIGHT + 4,
# so the pool can never be smaller than the requests that may hold a
# connection at once; a value below that turns load into refusals (503 on
# the reservation, a bypass on every cost decision), not into breaker trips.
# DODEAL_REDIS_MAX_CONNECTIONS=
# How long a caller waits for a connection at the cap before it is refused.
DODEAL_REDIS_POOL_ACQUIRE_TIMEOUT_SECONDS=1.0
# The real-Redis test lane (pytest -m redis_real). Unset by default: the lane
# is skipped, never failed, without it. Use a database the service does not
# (db0 to db3 are the queue, cost, operational and jobs stores).
# DODEAL_REDIS_REAL_URL=redis://localhost:6379/9
# Circuit breaker, one per Redis connection. Consecutive failures that open it,
# and how long it refuses before ONE probe is let through. Both provisional,
# both must be positive.
DODEAL_BREAKER_FAILURE_THRESHOLD=5
DODEAL_BREAKER_OPEN_SECONDS=30.0
# One deadline for the whole judgement, fetch included. PROVISIONAL: must be
# at or below the CRM's own inline timeout (Q16); above it, the CRM abandons
# requests we go on to finish.
DODEAL_JUDGEMENT_DEADLINE_SECONDS=25.0
# Requests judged at once per process; the rest are refused at the door with
# 503 load_shed. PLACEHOLDER until the load lane sets it. The Redis pool is
# derived from this value unless DODEAL_REDIS_MAX_CONNECTIONS overrides it.
DODEAL_MAX_INFLIGHT=32
# The largest request body the app will read, in bytes. Above it the
# request is refused with 413 payload_too_large at the outermost
# middleware, before any gate runs. 64 kB is four times the largest real
# note plus its lead fields: a memory bound, not a content rule. This does
# not replace the edge limit; it is what holds when the edge has none.
DODEAL_MAX_REQUEST_BODY_BYTES=65536
# Cost gate: per-tenant and per-user request caps, reset every window.
DODEAL_COST_PER_TENANT_LIMIT=10000
DODEAL_COST_PER_USER_LIMIT=1000
DODEAL_COST_WINDOW_SECONDS=86400
# Token budget, on the same window but its own keys: what was spent, not how
# many requests were made. Over budget is 429 token_budget_exceeded.
DODEAL_COST_TOKENS_PER_TENANT_LIMIT=5000000
DODEAL_COST_TOKENS_PER_USER_LIMIT=500000
# Fraction of a limit at which a running total earns one warning line.
# Strictly between 0 and 1.
DODEAL_COST_TOKEN_WARNING_RATIO=0.9

# Effective level for the dodeal_ai logger tree.
DODEAL_LOG_LEVEL=INFO
# Path to the hand-marked scored set, read only by the eval scripts and the eval lane.
# Unset by default: unset means every eval test skips, and CI never sets it.
# A path inside this repository is REFUSED — real notes never enter the repo.
# DODEAL_EVAL_SET_PATH=

# The scheme LeadsClient builds every backend URL with: https or http, nothing else.
# Leave it commented for https -- the per-tenant DD-API-KEY rides every request and must
# never cross the wire in clear. http is DEMO ONLY (.env.demo); in production it leaks keys.
# DODEAL_BACKEND_SCHEME=https

# How long a model call waits for a free pooled connection (register item 112).
# 1.0 s fails a burst fast as provider_pool_exhausted, a 503 model_unavailable;
# too low refuses a brief queue, too high hides a full pool inside the call.
DODEAL_LLM_POOL_ACQUIRE_TIMEOUT_SECONDS=1.0

# Optional fallback provider (register item 21): tried once when the primary
# gave no response body (connect error, 429, 503, breaker open), never on a
# timeout or a malformed 200. Unset = no fallback; set it only with all three.
# DODEAL_LLM_FALLBACK_PROVIDER=
# The fallback's exact pinned model id, for every task (profiles are the
# primary's). Required with a provider, or startup refuses.
# DODEAL_LLM_FALLBACK_MODEL=
# The fallback provider's key; never logged. Required with a provider.
# DODEAL_LLM_FALLBACK_API_KEY=
# Proxy override for the fallback's base URL; unset uses the provider's own.
# DODEAL_LLM_FALLBACK_BASE_URL=

# Providers besides the pair above, by name (core/llm/routing.py), e.g.
# {"owner":{"kind":"openai_compatible","base_url":"http://10.0.0.5:8000/v1",
# "api_key_env":"OWNER_LLM_KEY","timeout_seconds":60}}. The key is read from
# the variable named, never from here; {} = the pair only. A profile's
# "provider" may name one; an unknown name or an empty key variable refuses start.
DODEAL_LLM_PROVIDERS={}
# Routes a tenant may pick with unit_a/unit_b model_route, e.g.
# {"device":{"unit_b.extract":"owner.extract"}}: pass name -> profile name.
# "default" is DODEAL_LLM_* and cannot be set here. {} = default only; a route
# naming an unknown pass or profile refuses start.
DODEAL_MODEL_ROUTES={}

# Directory of per-tenant rubric files, one <tenant>.json each (register item 97).
# Unset = every tenant uses the built-in default. A missing directory or an
# invalid file refuses startup, naming the tenant and never the path.
# DODEAL_TENANT_CONFIG_DIR=

# The proxies whose X-Forwarded-For/-Proto uvicorn believes (register item 94).
# Loopback only by default; set the ingress addresses. "*" lets any client
# forge its address and scheme.
DODEAL_FORWARDED_ALLOW_IPS=127.0.0.1

# Whether GET /metrics answers (register item 22). Off by default: the page sits
# outside the gates, so turn it on only where the port is not public; on a
# public port it tells anyone the traffic and failure rates.
DODEAL_METRICS_ENABLED=false

# --- The CRM's service token (register item D1) ---------------------------
# The algorithm the CRM signs its service token with. RS256 by default so
# we hold only a public key; HS256 means a shared secret that can mint.
# A value the CRM does not sign with refuses every service call (401).
# DODEAL_SERVICE_JWT_ALGORITHM=RS256
# Verifies the service token: a public PEM for RS/ES (one line with \n
# escapes is accepted), the shared secret for HS. Unset = no service routes:
# /ready 503s and every direct, brief and admin call is 401.
# DODEAL_SERVICE_JWT_SIGNING_KEY=change-me-local-only
# The key being rotated out, tried only when the current one fails the
# signature. Unset outside a rotation; left set after one, a retired key
# still verifies tokens for as long as it stays here.
# DODEAL_SERVICE_JWT_PREVIOUS_SIGNING_KEY=change-me-local-only
# The `iss` the CRM puts on a service token. Fixed by agreement with the
# backend; a mismatch refuses every service call with invalid_issuer.
# DODEAL_SERVICE_JWT_ISSUER=dodeal-crm
# The `aud` a service token must name: this service. It stops a token minted
# for another CRM consumer being replayed here; a mismatch refuses them all.
# DODEAL_SERVICE_JWT_AUDIENCE=dodeal-ai
# The longest exp minus iat accepted, in seconds. 300 keeps a stolen token
# worth five minutes; too low refuses the CRM's own tokens as lifetime_exceeded.
# DODEAL_SERVICE_JWT_MAX_LIFETIME_SECONDS=300
# History judgements' own daily request cap per company (item 127).
DODEAL_COST_HISTORY_PER_TENANT_LIMIT=50000
# --- History judgements (register item 127) --------------------------------
# History judgements allowed in flight at once, per process, INSIDE
# DODEAL_MAX_INFLIGHT. 8 leaves live notes three quarters of the slots;
# above DODEAL_MAX_INFLIGHT it bounds nothing and a backfill starves them.
DODEAL_HISTORY_MAX_INFLIGHT=8
# The tenant's separate token budget for history judgements, per window:
# old notes scored in bulk are charged here and never to the live budget, so
# a backfill cannot starve today's judgements. Too low stalls a backfill.
DODEAL_COST_TOKENS_HISTORY_PER_TENANT_LIMIT=20000000
# The tenant's token budget for call analysis (Unit B), per window, on its own
# key. Over it, or with the cost store down, a call job pauses (paused_budget)
# and is retried after the window; too low pauses every call for the day.
DODEAL_COST_TOKENS_CALLS_PER_TENANT_LIMIT=20000000
# Seconds of call audio per company per window sent to speech-to-text,
# charged on download. 360000 is 100 hours; over it a call job pauses until
# the window turns. Too low pauses a busy floor; too high bounds no bill.
DODEAL_COST_AUDIO_SECONDS_PER_TENANT_LIMIT=360000

# --- Runtime tenant rules (register item 97) -------------------------------
# How long each process trusts the runtime override it last read from db2
# before reading it again. 30 s is how late a changed rule reaches the other
# pods; too high and an administrator's change looks lost.
DODEAL_TENANT_CONFIG_CACHE_SECONDS=30

# --- The brief's sources (register item 143) ------------------------------
# Where the brief and the measures read judgements and people: "crm" is the
# two CRM reads in tools/crm_reads.py, "none" is no source (503). Off by
# default: the endpoints are unconfirmed (ASSUMPTION[Q23]).
DODEAL_BRIEF_SOURCE=none
# Read routes' own daily request cap per company: brief, measures, admin (item 153).
#DODEAL_COST_READS_PER_TENANT_LIMIT=5000
# Call-job pushes per company per window, on cost:calls:tenant (Unit B): a job
# is minutes of audio and paid passes, so its own cap. 2000 is a busy floor's
# day; too low refuses real calls with 429.
DODEAL_COST_CALLS_PER_TENANT_LIMIT=2000
# The whole of one call recording's download, in seconds (Unit B). 60 fetches
# 200 MiB on a modest link; too low fails long calls as a timeout and retries
# them, too high holds a worker on a stalled source.
DODEAL_CALL_DOWNLOAD_TIMEOUT_SECONDS=60
# Processing attempts a call job gets before it is dead-lettered (Unit B). 2
# rides out one bad download or one failed transcription, re-paid at most once
# whatever this says. Higher re-fetches dead links; 1 never retries anything.
DODEAL_CALL_MAX_TRIES=2
# arq's timeout for one run of a call job, in seconds (Unit B); the run stops
# itself 60 s sooner, so under 120 refuses to start. Too low kills paid
# transcriptions mid-flight; too high lets a hung run hold a worker that long.
DODEAL_CALL_JOB_TIMEOUT_SECONDS=1800
# How long a call job's record lives after its last transition, in seconds
# (Unit B): a week outlives any retry or pause. Too low loses a paused job;
# too high keeps a stranded job's signed link and hashes for longer.
DODEAL_CALL_JOB_RECORD_TTL_SECONDS=604800
# Each company's callback signing secret, as JSON {"<tenant>":"<secret>"}. The
# CRM verifies every call.* callback with it. A company missing here gets no
# callback at all, never an unsigned one; a wrong one fails every verification.
DODEAL_CALL_CALLBACK_SECRETS={}
# USD per million tokens by the model name the provider reports, as JSON
# {"<model>":{"input":0,"cached_input":0,"output":0}}. Empty: every cost is
# null with one warning per task. A wrong price is a wrong cost on every line.
DODEAL_MODEL_PRICES={}
# USD per audio minute by speech-to-text model name, as JSON {"<model>":0}.
# Empty: every call's cost is null with one warning. A wrong value misstates
# every call's cost; the audio-seconds budget is unaffected.
DODEAL_STT_PRICES={}
# The name of the two price tables above, carried beside every cost. "unset"
# means there is no table; left stale after a price change, costs made under
# different tables read as one.
DODEAL_PRICE_TABLE_VERSION=unset
# DEMO ONLY (scripts/call_demo.py): admit http and loopback for call audio and
# callbacks, with an ERROR line at startup. Leave false: true anywhere real lets
# a push make this service fetch from and post to its own network.
DODEAL_CALL_DEMO_ALLOW_LOCAL_AUDIO=false
# The speech-to-text engine the "default" STT profile runs on: gemini,
# openai_compatible or diarized_http. "fake" is the demo's: it starts only with
# the flag above, and a worker with it and the flag off refuses to start.
DODEAL_CALL_STT_PROVIDER=fake
# STT profiles a tenant may pick with unit_b stt_profile, e.g.
# {"whisper":{"provider":"openai_compatible","base_url":"http://10.0.0.5:8001/v1",
# "model":"whisper-large-v3","api_key_env":"OWNER_STT_KEY"}}. Keys come from
# the variable named. {} = default only; a tenant naming another is a 422.
DODEAL_CALL_STT_PROFILES={}
# The default STT profile's endpoint; empty uses the engine's own (Gemini's).
# The HTTP engines need one. A wrong one fails every transcription, retried
# once, never billed twice.
DODEAL_CALL_STT_BASE_URL=
# The default STT profile's pinned model, carried on every transcript and
# priced under this name in DODEAL_STT_PRICES. A wrong one is refused by the
# engine: a permanent failure, unpaid.
DODEAL_CALL_STT_MODEL=gemini-3.5-transcribe
# The default STT profile's key; secret, never logged. Empty with a paid
# engine refuses the worker's start.
DODEAL_CALL_STT_API_KEY=
