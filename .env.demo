# =============================================================================
# .env.demo -- the committed demo runtime (register item 78).
#
# EVERY VALUE IN THIS FILE IS INVENTED. No real tenant, no real key, no real
# host. It is committed on purpose (.gitignore carries a `!.env.demo`
# negation), because the demo has to be reproducible from a clean checkout and
# a demo you have to be told the values for is not reproducible.
#
# THIS IS NOT .env.example. That file is a TEMPLATE, pinned field-for-field to
# core/config.py::Settings by tests/test_env_example_matches_settings.py, and
# it is where a new setting gets documented. This file is a DEMO ARTEFACT: it
# sets only what the demo needs to differ from the defaults, and the pin is
# deliberately NOT extended to it -- a demo forced to carry every setting
# would become a second, competing template that drifts against the first.
#
# HOW IT IS READ: docker-compose.demo.yml passes it as `env_file`, so Compose
# injects these as real environment variables. Nothing copies it over `.env`,
# and nothing here reaches a production deployment by accident.
#
# NEVER point this file at anything real. The moment a value here is a real
# tenant or a real key, it is a committed credential.
# =============================================================================

# --- Gate 1: the token -------------------------------------------------------
# Invented shared secret. scripts/mint_demo_token.py signs with it and the
# service verifies with it, so the demo mints its own valid tokens and needs
# nothing from the CRM. The script never prints it.
DODEAL_JWT_SIGNING_KEY=demo-only-change-me-not-a-real-signing-key-3f7a1c9e2b5d8046

# --- Gate 2: the host requests arrive under ----------------------------------
# Gate 2 requires Host == "<tenant>.<this>". The demo tenant is tenant-a, so a
# request must carry `Host: tenant-a.ai.demo.invalid`. .invalid is RFC 2606
# reserved and never resolves -- the Host header is compared, never dialled,
# and a name that cannot resolve cannot be reached by accident.
DODEAL_INBOUND_BASE_DOMAIN=ai.demo.invalid

# --- The fake CRM we fetch from ----------------------------------------------
# http, not https: the fake CRM is served plain on a laptop, which has no
# certificate for tenant-a.dodealcrm.com. DEMO ONLY -- see core/config.py.
DODEAL_BACKEND_SCHEME=http

# The outbound base domain, WITH ITS PORT. LeadsClient interpolates this
# straight into the URL, so ":8001" here yields
# http://tenant-a.crm.demo.invalid:8001/api/service/... -- the only way to
# reach a fake CRM that is not on port 80. docker-compose.demo.yml resolves
# tenant-a.crm.demo.invalid to the Docker host through extra_hosts; nothing
# is ever looked up in DNS.
DODEAL_BACKEND_BASE_DOMAIN=crm.demo.invalid:8001

# The per-tenant DD-API-KEY map. The fake CRM is expected to accept this value
# for tenant-a; an unknown tenant fails closed in tools/keys.py before any
# network call, so this map is what limits the demo to one tenant.
DODEAL_DD_API_KEYS={"tenant-a":"demo-only-change-me-not-a-real-dd-api-key"}

# --- Redis -------------------------------------------------------------------
# For the NON-Docker path (uvicorn on the laptop against the compose Redis).
# docker-compose.yml's `environment:` block overrides all three inside the
# container, where the host is `redis` and not localhost.
DODEAL_REDIS_QUEUE_URL=redis://localhost:6379/0
DODEAL_REDIS_COST_URL=redis://localhost:6379/1
DODEAL_REDIS_OPERATIONAL_URL=redis://localhost:6379/2

# --- The model ---------------------------------------------------------------
# DELIBERATELY UNSET, all three. Which model the demo runs on is the lead's
# decision and not this file's; ASSUMPTIONS.md 3.8 records Groq as
# DECISION[DEMO_PROVIDER], and the key belongs to a person, not to a commit.
# Until these are set /ready answers 503 {"llm":"not configured"} and every
# judgement route 503s -- the designed behaviour (register item 84), not a
# broken demo.
# DODEAL_LLM_PROVIDER=groq
# DODEAL_LLM_MODEL=
# DODEAL_LLM_API_KEY=change-me-the-demo-provider-key

# --- Logging -----------------------------------------------------------------
# INFO, so the demo prints its own outcome lines. DEBUG adds nothing a watcher
# reads and risks a longer line than a projector fits.
DODEAL_LOG_LEVEL=INFO
