__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

.venv/

# Delivery artefacts. A packaged copy of the source is a build OUTPUT, and the
# repository is the source -- committing one means the same code exists twice,
# with no way to tell which is current. AIService.zip is named as well as the
# glob because that is the one that kept reappearing in `git status` and being
# skipped by hand, commit after commit.
AIService.zip
*.zip

.env
.env.*
!.env.example

.pytest_cache/
.coverage
coverage.json
htmlcov/
.mypy_cache/
.ruff_cache/
.hypothesis/

.vscode/
.idea/

# Claude Code: settings.json is SHARED (committed, see CONTRIBUTING).
# Anything machine- or person-specific stays local and unversioned.
.claude/settings.local.json
.claude/*.local.*
*.swp
.DS_Store